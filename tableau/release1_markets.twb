  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Notes'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97844' id='3' type-v2='text' w='98730' x='635' y='1078'>
            <formatted-text>
              <run bold='true' fontcolor='#000000'>NOTES AND DEFINITIONS</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>Data source</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Yahoo Finance, downloaded with the Python package yfinance.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Date pulled: 18 November 2026</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>Date range</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>1 January 2021 to 31 December 2025 (five full years of daily trading data).</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>Prices</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Prices are adjusted for stock splits and dividends, so the history is comparable over time.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>KPI definitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Total Return: the percentage change in price from the first to the last trading day of the period.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- CAGR: the steady yearly growth rate that would turn the starting price into the ending price.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Annual Volatility: how much the daily price changes vary, scaled to one year (daily standard deviation × √252).</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Max Drawdown: the largest percentage fall from a previous peak to a later low.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Latest Close: the last closing price in the dataset.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Growth of 100: each price divided by its first-day price and multiplied by 100, so the lines start at the same point.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Drawdown from peak: how far each day&apos;s price sits below its highest previous close.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>Disclaimer</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>This is a personal data project for learning and portfolio purposes. It is not financial advice, and past performance does not predict future results.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
